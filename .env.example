# Copy this file to .env at the repo root (gitignored) to try the framework
# examples with real Google Places API (New) data.
#
# Create a key in Google Cloud Console with "Places API (New)" enabled. For
# local dev this key is used directly from the browser — restrict it (HTTP
# referrer: http://localhost:*) rather than leaving it unrestricted.
VITE_GOOGLE_PLACES_API_KEY=
