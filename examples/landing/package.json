{
  "name": "example-landing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Framework-neutral landing page for @anil-labs/google-places-autocomplete — the live demo runs the <gpa-autocomplete> web component directly, so it needs no framework runtime.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-page.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anil-labs/google-places-autocomplete-core": "workspace:*",
    "@anil-labs/google-places-autocomplete-element": "workspace:*",
    "example-shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "jsdom": "^30.0.1",
    "typescript": "~6.0.0",
    "vite": "^8.2.0"
  }
}
