{
  "name": "@anil-labs/google-places-autocomplete-react",
  "version": "0.1.0",
  "type": "module",
  "description": "React address autocomplete component built on Google's Places API (New).",
  "license": "MIT",
  "author": "Er. Anil Kumar Thakur <anilkumarthakur60@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anilkumarthakur60/google-places-autocomplete.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/anilkumarthakur60/google-places-autocomplete/tree/main/packages/react#readme",
  "bugs": "https://github.com/anilkumarthakur60/google-places-autocomplete/issues",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsup && node scripts/check-dist.mjs",
    "dev": "tsup --watch",
    "test": "echo \"covered by @anil-labs/google-places-autocomplete-core\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@anil-labs/google-places-autocomplete-core": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "~6.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
