{
  "name": "@anil-labs/google-places-autocomplete-solid",
  "version": "0.2.0",
  "type": "module",
  "description": "Solid address autocomplete component built on Google's Places API (New).",
  "license": "MIT",
  "author": "Er. Anil Kumar Thakur <anilkumarthakur60@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anilkumarthakur60/google-places-autocomplete.git",
    "directory": "packages/solid"
  },
  "homepage": "https://github.com/anilkumarthakur60/google-places-autocomplete/tree/main/packages/solid#readme",
  "bugs": "https://github.com/anilkumarthakur60/google-places-autocomplete/issues",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsup && node --conditions=browser scripts/check-dist.mjs",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@anil-labs/google-places-autocomplete-core": "workspace:^"
  },
  "peerDependencies": {
    "solid-js": "^1.8.0"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "esbuild-plugin-solid": "^0.6.0",
    "jsdom": "^29.0.2",
    "solid-js": "^1.9.14",
    "tsup": "^8.5.1",
    "typescript": "~6.0.0",
    "vite-plugin-solid": "^2.11.13",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
