{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleDetection": "force",
    "strict": true,
    "noImplicitThis": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "useDefineForClassFields": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    // tsup's dts step (rollup-plugin-dts) synthesizes its own compiler host
    // with an implicit `baseUrl`, which TS 6 now flags even though nothing
    // in this repo sets baseUrl itself. Nothing to migrate — just silence it.
    "ignoreDeprecations": "6.0"
  }
}
